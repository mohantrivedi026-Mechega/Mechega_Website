@inherits LayoutComponentBase
<div class="site-root">
    <header class="site-header">
        <div class="container">
            <div class="header-inner d-flex align-items-center justify-content-between flex-wrap gap-3 py-3">
                <a class="brand" href="/" aria-label="Mechega home">
                    <img src="/images/company%20Logo_Mechega.png" alt="Mechega company logo" class="brand-logo" />
                    <span class="brand-name">Mechega</span>
                </a>

                <nav class="main-nav" aria-label="Main navigation">
                    <NavMenu />
                </nav>
            </div>
        </div>
    </header>

    <main class="site-main container my-4">
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="site-footer bg-dark text-white py-4 mt-auto">
        <div class="container small">
            <div class="row">
                <div class="col-md-6">© Mechega 2026</div>
                <div class="col-md-6 text-md-end">Contact: <a href="mailto:mechega.safety@gmail.com" class="text-white">mechega.safety@gmail.com</a></div>
            </div>
        </div>
    </footer>
</div>
